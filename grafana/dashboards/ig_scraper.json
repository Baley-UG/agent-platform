    {
      "type": "timeseries",
      "title": "Job throughput (last 24h, by status)",
      "id": 11,
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "format": "time_series",
        "rawQuery": true,
        "rawSql": "SELECT date_trunc('hour', COALESCE(finished_at, started_at, created_at)) AS time, status AS metric, COUNT(*) AS value FROM ig_scrape_jobs WHERE COALESCE(finished_at, started_at, created_at) >= now() - interval '24 hours' GROUP BY time, status ORDER BY time"
      }]
    },
