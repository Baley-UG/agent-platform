      "type": "barchart",
      "title": "Score distribution",
      "id": 10,
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
      "targets": [{
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT (FLOOR(score / 10) * 10)::int AS bucket, COUNT(*) AS posts FROM ig_posts WHERE score IS NOT NULL AND first_seen_at >= now() - interval '7 days' GROUP BY bucket ORDER BY bucket"
      }]
