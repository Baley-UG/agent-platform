    {
      "type": "table",
      "title": "Top hashtags by velocity",
      "id": 20,
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "gridPos": {"x": 0, "y": 20, "w": 12, "h": 10},
      "targets": [{
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT hashtag, last_week_count, prior_week_count, post_delta, ROUND(last_week_avg_score::numeric, 1) AS last_week_avg_score FROM ig_hashtag_velocity ORDER BY post_delta DESC NULLS LAST LIMIT 25"
      }]
    },
    {
      "type": "table",
      "title": "Top scoring posts (last 7 days)",
      "id": 21,
      "datasource": {"type": "postgres", "uid": "${DS_POSTGRES}"},
      "gridPos": {"x": 12, "y": 20, "w": 12, "h": 10},
      "targets": [{
        "format": "table",
        "rawQuery": true,
        "rawSql": "SELECT u.username AS author, p.code, p.like_count, p.play_count, ROUND(p.score::numeric, 1) AS score, p.taken_at FROM ig_posts p JOIN ig_users u ON u.id = p.author_id WHERE p.taken_at >= now() - interval '7 days' AND p.score IS NOT NULL ORDER BY p.score DESC LIMIT 25"
      }]
    }
