# Render worker — same Python deps as the main image, plus ffmpeg for compose jobs.
# Used only by the `media_render` RQ queue worker. CPU-bound; scale this container
# independently of the API / generic worker.
FROM python:3.13.2-slim

WORKDIR /app

ARG APP_ENV=production

ENV APP_ENV=${APP_ENV} \
    PYTHONFAULTHANDLER=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=on \
    PYTHONPATH=/app \
    VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
        ca-certificates \
        ffmpeg \
        # drawtext overlays (renderer._FONT_FILE points at DejaVuSans-Bold)
        fonts-dejavu-core \
    && pip install --upgrade pip \
    && pip install uv \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -version | head -1

COPY pyproject.toml .
RUN uv venv /app/.venv \
    && . /app/.venv/bin/activate \
    && uv pip install -e .

COPY . .

RUN useradd -m appuser && chown -R appuser:appuser /app
USER appuser

# Render container consumes ffmpeg-bound queues:
#   - media_render   → compose pipeline (Phase 1)
#   - frame_extract  → brand-video keyframe pass (Phase 3)
#   - segment_cut    → repurpose source-segment cutting
# All need the ffmpeg binary baked into this image. Other queues
# (analyzer, image_gen, etc.) stay on the generic worker.
CMD ["python", "-m", "app.worker", "--queues", "media_render", "frame_extract", "segment_cut"]
