# Environment Configuration Example

# Application Settings
APP_ENV=development
PROJECT_NAME="Web Assistant"
VERSION=1.0.0
DEBUG=true

# API Settings
API_V1_STR=/api/v1

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000"

# Langfuse Settings
LANGFUSE_PUBLIC_KEY="your-langfuse-public-key"
LANGFUSE_SECRET_KEY="your-langfuse-secret-key"
LANGFUSE_HOST=https://cloud.langfuse.com

# LLM Settings
OPENROUTER_API_KEY="your-llm-api-key" # e.g. OpenRouter/OpenAI/Anthropic key
LLM_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_MODEL=gpt-4o-mini
DEFAULT_LLM_TEMPERATURE=0.2

# JWT Settings
JWT_SECRET_KEY="your-jwt-secret-key"
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30

# Database Settings
POSTGRES_HOST=db
POSTGRES_DB=mydb
POSTGRES_USER=myuser
POSTGRES_PORT=5432
POSTGRES_PASSWORD=mypassword
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

# Rate Limiting Settings
RATE_LIMIT_DEFAULT="1000 per day,200 per hour"
RATE_LIMIT_CHAT="100 per minute"
RATE_LIMIT_CHAT_STREAM="100 per minute"
RATE_LIMIT_MESSAGES="200 per minute"
RATE_LIMIT_LOGIN="100 per minute"

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

#SLACK
SLACK_BOT_TOKEN="your-slack-bot-token"
SLACK_SIGNING_SECRET="your-slack-signing-secret"

# ============================================================================
# ig_scraper service (services/ig_scraper)
# ============================================================================

# Host-side port for ig-scraper-api. Override when 8081 is taken by
# something else; the container always listens on 8081 internally.
IG_SCRAPER_HOST_PORT=8081

# Auth — used by callers that hit /api/v1/* on port 8081 and the MCP /mcp/.
# Generate with: openssl rand -hex 32
IG_SCRAPER_API_KEY="changeme-not-a-real-key"

# Fernet key for encrypting stored account passwords + proxy creds.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IG_SECRET_KEY="changeme-fernet-key"

# Optional: read-replica DSN. Leave unset to read from the primary.
# POSTGRES_READ_REPLICA_DSN="postgresql://user:pass@replica-host:5432/mydb"

# Worker / scheduler concurrency.
IG_WORKER_CONCURRENCY=2
IG_SCHEDULER_TICK_SECONDS=60

# Stuck-job reaper (in case a worker crashes mid-scrape).
IG_JOB_STUCK_AFTER_MINUTES=60
IG_REAPER_INTERVAL_SECONDS=60

# Anti-detection delays (seconds). See plan § 5.3.
IG_DELAY_FEED_MIN=4
IG_DELAY_FEED_MAX=10
IG_DELAY_POST_MIN=6
IG_DELAY_POST_MAX=14
IG_DELAY_PROFILE_MIN=5
IG_DELAY_PROFILE_MAX=12
IG_DELAY_STORY_MIN=3
IG_DELAY_STORY_MAX=8
IG_DELAY_HASHTAG_MIN=7
IG_DELAY_HASHTAG_MAX=15
IG_DELAY_LOGIN_MIN=20
IG_DELAY_LOGIN_MAX=40
IG_MICRO_JITTER_MIN=0.5
IG_MICRO_JITTER_MAX=2.0

# Macro pauses & long breaks.
IG_MACRO_PAUSE_EVERY_MIN=8
IG_MACRO_PAUSE_EVERY_MAX=20
IG_MACRO_PAUSE_SECONDS_MIN=30
IG_MACRO_PAUSE_SECONDS_MAX=180
IG_LONG_BREAK_PROBABILITY=0.33
IG_LONG_BREAK_SECONDS_MIN=300
IG_LONG_BREAK_SECONDS_MAX=900

# Session caps & cooldown.
IG_SESSION_MAX_MINUTES=25
IG_SESSION_MAX_CALLS=300
IG_ACCOUNT_COOLDOWN_MIN=1200
IG_ACCOUNT_COOLDOWN_MAX=3600

# Tiered daily quotas (fresh < mid < warm).
IG_DAILY_QUOTA_FRESH=250
IG_DAILY_QUOTA_MID=800
IG_DAILY_QUOTA_WARM=1500
IG_MAX_REQUESTS_PER_ACCOUNT_PER_DAY=1500
IG_WARMUP_HOURS=72

# Job knobs.
IG_MAX_POSTS_PER_JOB=2000
IG_COMMENT_DEFAULT_LIMIT=50
IG_DEFAULT_INTERVAL_HOURS=24
IG_TARGET_INTERVAL_JITTER_PCT=15

# Hashtag enrichment / auto-promotion thresholds.
IG_AUTO_PROMOTE_DISCOVERED=false
IG_MIN_FOLLOWERS_FOR_ENRICH=5000
IG_MIN_MEDIA_FOR_ENRICH=12
IG_MIN_SCORE_FOR_ENRICH=50

# Scoring weights (must sum to ~1.0 — don't tune blindly).
IG_SCORE_HALFLIFE_DAYS=14
IG_SCORE_W_ENGAGEMENT=0.20
IG_SCORE_W_VELOCITY=0.25
IG_SCORE_W_VIEW_EFFICIENCY=0.10
IG_SCORE_W_COMMENT_INTENSITY=0.10
IG_SCORE_W_AUTHOR_RELATIVE=0.25
IG_SCORE_W_FRESHNESS=0.10

# ----- HikerAPI (third-party IG data provider) ----------------------
# Drop-in replacement for the instagrapi-based scrapers. When enabled,
# scraping goes through HikerAPI's REST service — no IG account / proxy
# needed on our side, the provider handles auth and anti-bot.
USE_HIKERAPI=false
HIKERAPI_KEY=
HIKERAPI_BASE_URL=https://api.hikerapi.com
HIKERAPI_TIMEOUT_SECONDS=30
HIKERAPI_MAX_RETRIES=3
HIKERAPI_PAGE_SIZE=50
# privacy_check=true ikiye katlanan istek demek; biz is_private'i payload'dan
# zaten okuyoruz, bu kontrole ihtiyacımız yok. Default false bırakın.
HIKERAPI_PRIVACY_CHECK=false

# ============================================================================
# content_pipeline service (services/content_pipeline)
# ============================================================================

# Host-side port for content-pipeline-api. Override when 8082 is taken.
CP_HOST_PORT=8082

# Auth — single static key for X-API-Key on /api/v1/*.
# Generate with: openssl rand -hex 32
CP_API_KEY="changeme-not-a-real-key"

# Fernet key for encrypting social_accounts.credentials_encrypted at rest.
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CP_SECRET_KEY="changeme-fernet-key"

# Worker / scheduler concurrency
CP_WORKER_CONCURRENCY=2
CP_SCHEDULER_TICK_SECONDS=60

# ----- Redis (shared broker for RQ) ----------------------------------
# Distinct REDIS_DB index from any future ig_scraper Redis usage to
# avoid key collisions. ig_scraper itself does not use Redis today.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# ----- S3 storage ---------------------------------------------------
# Dev (MinIO, started by docker-compose.override.yml):
S3_ENDPOINT=http://minio:9000
S3_BUCKET=content-pipeline-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# MinIO requires path-style; switch to false for Hetzner / AWS.
S3_USE_PATH_STYLE=true
S3_PRESIGNED_URL_TTL_SECONDS=3600

# Prod (Hetzner Object Storage) — example, override in .env.production:
# S3_ENDPOINT=https://<region>.your-objectstorage.com
# S3_BUCKET=...
# S3_ACCESS_KEY=...
# S3_SECRET_KEY=...
# S3_USE_PATH_STYLE=false

# ----- CP-M9 admin auth (lives in main `app/`) -----
# Token signing secret. Falls back to JWT_SECRET_KEY when blank.
# Generate with: openssl rand -hex 32
ADMIN_JWT_SECRET=
ADMIN_ACCESS_TOKEN_TTL_MINUTES=60
ADMIN_REFRESH_TOKEN_TTL_DAYS=7

# First admin is created via the CLI (no env-based bootstrap):
#   docker compose exec app python -m app.cli create-admin --email <you@domain>
# Subsequent admins are added through the admin panel UI or:
#   docker compose exec app python -m app.cli set-role --email <...> --role admin

# Downstream microservice URLs (gateway calls) and their X-API-Key tokens:
CONTENT_PIPELINE_URL=http://content-pipeline-api:8082
IG_SCRAPER_URL=http://ig-scraper-api:8081
# CP_API_KEY and IG_SCRAPER_API_KEY come from each service's existing config.